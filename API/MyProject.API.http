@MyProject.API_HostAddress = http://localhost:5198

### Add
POST {{MyProject.API_HostAddress}}/api/items
Content-Type: application/json

{
  "id": 0,
  "name": "Keyboard",
  "description": "Mechanical keyboard",
  "price": 79.99,
  "itemState": 1
}

### Add or edit (id 0 inserts; positive id updates)
POST {{MyProject.API_HostAddress}}/api/items
Content-Type: application/json

{
  "id": 0,
  "name": "Mouse",
  "description": "Wireless mouse",
  "price": 39.50,
  "itemState": 2
}

